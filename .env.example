# apps/api
PORT=3333
JWT_SECRET=changeme
# Origin do frontend liberado pelo CORS (precisa ser exato, cors com credentials:true não aceita wildcard)
FRONTEND_URL=http://localhost:3000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3333
# Precisa ser IDÊNTICO ao JWT_SECRET da api — usado pelo middleware.ts para validar a sessão
JWT_SECRET=changeme
